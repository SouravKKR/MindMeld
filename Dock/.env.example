# Dock server environment configuration.
#
# Copy this file to `Dock/.env` and fill in real values. `.env` is gitignored;
# this `.env.example` is committed as documentation — keep it free of secrets.
# All values are read once at boot (dotenv) by Dock/index.js, so restart the
# server after changing anything here.

# ── Required ────────────────────────────────────────────────────────────────

# MongoDB connection string and database name.
MONGODB_URL=mongodb://127.0.0.1:27017
MONGODB_DATABASE_NAME=cogniumlearn

# Google OAuth credentials (sign-in).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Paid-deck master key — the root secret of the paid-deck encryption scheme.
# MUST be a base64-encoded 32-byte (256-bit) AES key. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Without it, KeyManagementService never becomes ready and every paid-deck
# write endpoint returns HTTP 503 KEY_MANAGEMENT_NOT_READY.
#
# WARNING: once any paid deck has been uploaded, this key MUST stay constant
# forever. It wraps every deck's content key at rest and derives all per-deck
# and per-user KEKs — losing or changing it makes all encrypted assets and
# buyer licenses permanently undecryptable. Back it up somewhere secure.
PAID_DECK_MASTER_KEY_BASE64=

# ── Access allowlist (dev/test only) ────────────────────────────────────────
# Per-environment login gate. When ENABLED, only "allowed" emails may log in
# (both Google OAuth and email-OTP paths), where allowed = the union of the
# comma-separated ACCESS_ALLOWLIST_EMAILS below, every admin email, and the
# allowedLoginEmails collection (managed in the admin panel's Access tab).
# Being on the allowlist only PERMITS login — it never grants the admin role.
#
# LEAVE ACCESS_ALLOWLIST_ENABLED BLANK IN PRODUCTION. When unset/blank the gate
# is OFF and everyone can log in exactly as normal — this is the default and the
# required production configuration. Only set it (to 1/true/yes) in a dev or
# test environment you want to lock down to a known set of testers.
ACCESS_ALLOWLIST_ENABLED=
ACCESS_ALLOWLIST_EMAILS=

# ── Recommended ─────────────────────────────────────────────────────────────

# Public origin used to build OAuth redirect URLs etc.
# Defaults to = 127.0.0.1:3000 when unset or in debug mode.
DOMAIN_NAME=

# Redis URL for the task queue and FX-rates cache.
# Defaults to redis://127.0.0.1:6379 when unset.
REDIS_URL=redis://127.0.0.1:6379

# European Central Bank daily FX reference feed (regional-price conversion).
# Defaults to the official URL below when unset.
ECB_RATES_URL=https://www.ecb.europa.eu/stats/eurofxref/eurofxref-daily.xml

# ── AI / Agent ──────────────────────────────────────────────────────────────

# Agent Vertex AI auth (GOOGLE_ENTERPRISE_AGENT_PROJECT / _CREDENTIALS_BASE64, or the slow
# _API_KEY fallback) and OPENAI_API_KEY are NOT set in this file and are NOT
# used by Dock — Dock makes no LLM calls; all AI runs in the Agent. They live
# solely in the sibling Agent env file (../Agent/.env in --debug, else
# ../Agent/.production.env) and are used only by the Agent. Dock reads that file
# ONLY to forward the keys to burst workers via cloud-init
# (BurstFleetSettings.getWorkerRuntimeEnvironment). Put the keys in the Agent env
# file, not here.

# Absolute path to the Python Agent service entry point (task processing).
AGENT_SERVICE_PATH=

# ── Payments ────────────────────────────────────────────────────────────────

# Default provider for purchase order creation: RAZORPAY | STRIPE | PAYPAL.
# Razorpay is the only fully implemented provider — it creates every order,
# settles every flow and is the sole provider for recurring plan subscriptions.
# Stripe and PayPal are stubs whose methods throw if selected.
DEFAULT_PAYMENT_PROVIDER=RAZORPAY

# Invoicing is deliberately NOT automated. Invoices are produced outside the
# application and attached for the record through
# /Admin/Credits/Deals/UploadInvoice, which stores the file in object storage
# and keeps the pointer on the deal row. Paid-deck buyers can additionally
# render a receipt on demand from their own purchase record at
# /PaidDecks/Purchases/Invoice. There is no invoicing provider to configure.

# ── Razorpay ───────────────────────────────────────────────────────────────
# Default order provider (DEFAULT_PAYMENT_PROVIDER above) and the ONLY provider
# for recurring plan subscriptions, so these are required wherever plans are sold.
#
# The key mode is enforced at boot by PaymentEnvironmentValidator: a test key on
# a deployed production node, or a live key anywhere else, refuses to start.
# "Deployed" means COGNIUMLEARN_SECRETS_DIRECTORY is set — a local
# `npm run production` is expected to use test keys and is allowed to.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Signs inbound webhook bodies. SEPARATE from RAZORPAY_KEY_SECRET above, which
# signs the browser's payment response — different value, different purpose.
RAZORPAY_WEBHOOK_SECRET=
# Set to the OUTGOING secret for ~24 hours after rotating the one above, then
# clear it. Razorpay retries a failed event for 24 hours and every retry is
# still signed with the secret current when the event was created, so without
# this a rotation silently drops a day of payment confirmations. Deliveries that
# match it are flagged `usedPreviousSecret` in the webhookEvents collection —
# when none appear, the old secret is safe to remove.
RAZORPAY_WEBHOOK_SECRET_PREVIOUS=

STRIPE_SECRET_KEY=

PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# ── Email ───────────────────────────────────────────────────────────────────
# Outbound email (sign-in OTP codes, org-admin verification, future
# notifications) goes through a pluggable provider. DEFAULT_EMAIL_PROVIDER picks
# the active transport by EmailProviderTypes name: SES (default) or SMTP.
# EMAIL_SOURCE_EMAIL is the provider-neutral "from" address; with SES it MUST be
# a verified SES identity (email or domain). If left blank it falls back to
# SMTP_SOURCE_EMAIL below.
# The display name shown beside that address ("CogniumLearn Security", …) is NOT
# configured here — it varies per email type and lives in code, in
# Globals/Classes/Email/EmailSenderIdentities.js. Only the address needs to be a
# verified identity; the name beside it is free text.
DEFAULT_EMAIL_PROVIDER=SES
EMAIL_SOURCE_EMAIL=

# AWS SES (active provider). Fill these in / push to GSM later.
SES_REGION=
SES_ACCESS_KEY_ID=
SES_SECRET_ACCESS_KEY=

# ── Push notifications (Firebase Cloud Messaging) ────────────────────────────
# FCM is the unified push transport for web, Android and iOS. The first three
# values come from a Firebase service-account JSON (Project settings → Service
# accounts → Generate new private key). FIREBASE_PRIVATE_KEY is the multi-line
# PEM stored on ONE line with literal "\n" escapes (the server restores the
# newlines). FIREBASE_VAPID_KEY is the Web Push certificate public key (Project
# settings → Cloud Messaging → Web Push certificates) the browser client needs
# to obtain a token. Leave blank until provisioned — the server runs normally
# without them and PUSH-channel sends simply no-op. Fill in / push to GSM later.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_VAPID_KEY=

# SMTP (fallback provider — set DEFAULT_EMAIL_PROVIDER=SMTP to use).
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_SOURCE_EMAIL=

# ── Rate limiting (optional) ────────────────────────────────────────────────
# All are positive integers; blank/invalid values fall back to the defaults
# shown. They apply to every endpoint except static resources.

# Overall per-endpoint cap (Packetron's built-in maxRequestsPerSecond). This is
# the combined cap across all users for a single endpoint. Default: 100.
RATE_LIMIT_OVERALL_MAX_REQUESTS_PER_SECOND=100

# Per-user cap: max requests one identity (logged-in user, else client IP) may
# make within the window below before receiving 429s. Default: 300.
RATE_LIMIT_PER_USER_MAX_REQUESTS=300

# Per-user window length in seconds for the cap above. Default: 60.
RATE_LIMIT_PER_USER_WINDOW_SECONDS=60

# Dedicated tight per-IP cap for the OAuth login handshake (/Login + Callback),
# to deter login abuse. A normal sign-in is two requests. Raise for deployments
# behind a shared NAT (e.g. a school) where many users share one IP. Default: 20.
RATE_LIMIT_LOGIN_MAX_REQUESTS=20

# Window length in seconds for the login cap above. Default: 300.
RATE_LIMIT_LOGIN_WINDOW_SECONDS=300

# Dedicated tight per-IP cap for the email-OTP endpoints (/Auth/RequestOtp +
# /Auth/VerifyOtp). /Auth/RequestOtp sends an email on every call, so this caps
# how many OTP emails one IP can trigger (email-bomb / cost abuse) and bounds
# distributed code guessing. A normal flow is one request plus a few verify
# attempts. Raise for deployments behind a shared NAT. Default: 20.
RATE_LIMIT_OTP_MAX_REQUESTS=20

# Window length in seconds for the OTP cap above. Default: 300.
RATE_LIMIT_OTP_WINDOW_SECONDS=300

# Dedicated per-user cap for the generation cost estimator
# (/Generate/EstimateCost). Pricing the run is a mandatory step of Start
# Generation, so this has to leave room for a normal decision — start, read the
# estimate, cancel, change a field, start again — while still stopping a script
# from hammering it. Each call loads the credit configuration and walks the
# whole settings body; the client re-uses its last answer for an unchanged form.
# Default: 5.
RATE_LIMIT_ESTIMATE_MAX_REQUESTS=5

# Window length in seconds for the estimate cap above. Default: 30.
RATE_LIMIT_ESTIMATE_WINDOW_SECONDS=30

# ── Paid-deck license duration — Optional ───────────────────────────────────
# Each paid deck declares how long a buyer's license lasts: a positive
# durationDays (finite rental) or isPerpetual (lifetime access), set per deck and
# optionally overridden per region in the admin panel.
#
# By default a deck that declares NEITHER is granted perpetually — the semantics
# every deck predating those fields was actually sold under — and the grant is
# recorded with a PURCHASE_DECK warning naming the deck so the catalogue entry
# can be corrected. Free decks are always perpetual: nothing is being sold, so
# there is no term to declare.
#
# Set to "true" to refuse a PRICED deck with no declared duration instead
# (HTTP 422 PRICING_DURATION_NOT_CONFIGURED, before any payment order is
# created), forcing admins to be explicit. Free decks stay unaffected.
# Default: unset (grant perpetually and warn).
PAID_DECK_REQUIRE_EXPLICIT_LICENSE_DURATION=

# ── Security headers / Content-Security-Policy — Optional ───────────────────
# Every response carries CSP, X-Frame-Options, X-Content-Type-Options,
# Referrer-Policy and (over HTTPS) HSTS. Everything below is optional; leaving it
# all unset ENFORCES the strict Content-Security-Policy.

# Set to "true" to stop emitting the security headers entirely. Default: unset.
SECURITY_HEADERS_DISABLED=

# Which policy is ENFORCED:
#   strict (default) — script-src drops 'unsafe-inline' and 'unsafe-eval' and
#                      replaces blanket https: with an explicit origin
#                      allow-list (AdSense + SODAR, Razorpay checkout, the
#                      Cloudflare beacon). This is the policy that actually
#                      blocks injected script on a page where a payment is
#                      taken, which is why it is the default.
#   compatible       — the permissive predecessor: script-src allows
#                      'unsafe-inline', 'unsafe-eval' and any https: origin. It
#                      blocks no injected script at all. This is an ESCAPE
#                      HATCH, not a supported resting state.
#
# ROLLBACK: if a third party breaks after this ships — AdSense injecting inline
# script at runtime is the realistic candidate, and it would show as blank ad
# slots rather than a broken checkout — set this to "compatible" and restart.
# That restores the previous behaviour exactly, and the strict policy then rides
# along as Content-Security-Policy-Report-Only so the evidence needed to go back
# to strict keeps accumulating. No deploy required either way.
#
# Either mode reports violations: the enforced strict policy carries report-uri,
# so promotion does not blind you. Watch the admin panel's Alerts tab for
# CSP_VIOLATION entries covering ads, all four checkout flows and the in-browser
# LLM. A legitimate origin showing up there belongs in SecurityHeaders'
# STRICT_SCRIPT_ORIGINS list, not in a mode downgrade.
CONTENT_SECURITY_POLICY_MODE=

# Full verbatim policy string. Replaces the built-in policy entirely and
# suppresses the report-only companion — set this only if you want to own the
# policy yourself. Default: unset.
CONTENT_SECURITY_POLICY=

# "true" sends the ENFORCED policy in report-only mode instead (so it blocks
# nothing). Also suppresses the companion. Default: unset.
CONTENT_SECURITY_POLICY_REPORT_ONLY=

# "true" drops the report-only companion header, silencing violation reports
# while leaving the enforced policy alone. Default: unset.
CONTENT_SECURITY_POLICY_REPORTING_DISABLED=

# Where browsers post violation reports. The built-in sink records them as
# CSP_VIOLATION alerts. Default: /Security/CspReport.
CONTENT_SECURITY_POLICY_REPORT_URI=

# "true" stops the daily script-integrity check [PCI DSS 11.6.1]. That check
# re-hashes the served Dock/Static tree against the manifest the build wrote and
# re-fetches the Razorpay checkout script to see whether its bytes changed,
# raising admin alerts either way. Leave it unset in any environment that takes
# payments. Default: unset (monitoring ON).
SCRIPT_INTEGRITY_MONITORING_DISABLED=

# Referrer-Policy header. Default: strict-origin-when-cross-origin.
REFERRER_POLICY=

# X-Frame-Options header. Default: SAMEORIGIN.
X_FRAME_OPTIONS=

# HSTS max-age in seconds, emitted only on HTTPS requests. "0" disables HSTS.
# Default: 15552000 (180 days).
HSTS_MAX_AGE_SECONDS=
HSTS_INCLUDE_SUBDOMAINS=
HSTS_PRELOAD=

# ── Task queue + burst fleet — Optional ─────────────────────────────────────
# Distributed task processing. When OFF (or whenever the server runs with
# --debug), Agent tasks run as local subprocesses exactly as before. When ON,
# Dock pushes tasks onto a Redis queue that long-lived worker processes drain —
# a warm baseline on this node plus optional cloud burst VMs. Everything here is
# polling-based and hard-capped, so it can never runaway-spend. Only takes effect
# in production (server started WITHOUT --debug).

# Master switch for the queue + worker pool + autoscaler. Default: off.
DOCK_USE_TASK_QUEUE=0

# How many long-lived worker processes Dock keeps running on THIS (base) node.
# These are the always-warm baseline. Default: 2.
AGENT_LOCAL_WORKER_COUNT=2

# How long Dock waits for a queued task to finish before treating it as failed.
# Kept below the 5h task TTL. Default: 10800 (3h). Poll cadence in ms below.
TASK_QUEUE_AWAIT_TIMEOUT_SECONDS=10800
TASK_QUEUE_AWAIT_POLL_MILLISECONDS=1000

# Worker liveness/claim tuning (read by Agent workers). Lease is refreshed while
# a task runs; the reaper requeues a task whose lease expired (worker crashed).
AGENT_WORKER_LEASE_SECONDS=1800
AGENT_WORKER_CLAIM_BLOCK_SECONDS=5
AGENT_WORKER_REAPER_INTERVAL_SECONDS=60
# Worker processes per burst VM (each competes on the same queue). Default: 1.
AGENT_WORKERS_PER_VM=1

# ── Cloud burst autoscaler ──────────────────────────────────────────────────
# Which cloud backend to provision burst VMs on. Swappable; LINODE is the only
# implemented provider today. Default: LINODE.
DEFAULT_CLOUD_COMPUTE_PROVIDER=LINODE

# Linode (Akamai) API personal access token with Linodes read/write scope.
LINODE_API_TOKEN=

# Region, pre-baked Image id, and instance type for BURST VMs. Burst VMs can be
# smaller/cheaper than the base node. (The base node is provisioned manually;
# BASE_INSTANCE_TYPE is documentation only and not read by the code.)
BURST_REGION=
BURST_IMAGE_ID=
BURST_INSTANCE_TYPE=
BASE_INSTANCE_TYPE=

# Linode VPC the burst VMs join so they reach Redis/Mongo over private IPs only.
BURST_VPC_ID=
BURST_SUBNET_ID=

# REQUIRED. Numeric id of the Cloud Firewall every burst VM is bound to at
# creation — use a dedicated burst firewall (inbound DROP, outbound ACCEPT). Burst
# VMs are dual-homed (public interface for egress + VPC interface for Redis/Mongo),
# so this firewall's inbound-DROP is their network protection. Fail-closed: if
# unset, the autoscaler reports unconfigured and creates NO burst VM. Find the id
# in the Linode Cloud Manager (Firewalls) or via:  GET /v4/networking/firewalls
BURST_FIREWALL_ID=

# How burst VMs reach Redis/Mongo (private VPC URLs). Fall back to the main
# REDIS_URL / MONGODB_URL if unset.
BURST_WORKER_REDIS_URL=
BURST_WORKER_MONGODB_URL=

# Identity of framework-managed instances. The autoscaler ONLY ever touches
# instances carrying this tag, and deletes ALL of them on startup so a restart
# never inherits stray burst VMs.
BURST_MANAGEMENT_TAG=cogniumlearn-burst
BURST_LABEL_PREFIX=cogniumlearn-burst-

# Warm pool floor (always-on burst VMs to hide cold-start latency) and the HARD
# cap on total burst VMs (never exceeded — the runaway-spend guard).
BURST_WARM_POOL_SIZE=2
BURST_MAX_INSTANCES=8

# Scaling shape: how many pending tasks one instance is sized to absorb, how long
# an instance must be idle before shutdown, and the reconcile poll interval.
BURST_TASKS_PER_INSTANCE=2
BURST_IDLE_TIMEOUT_SECONDS=600
BURST_RECONCILE_INTERVAL_SECONDS=30

# Cooldowns (anti-thrash) and how many VMs may be created per scale-up tick.
BURST_SCALE_UP_COOLDOWN_SECONDS=60
BURST_SCALE_DOWN_COOLDOWN_SECONDS=300
BURST_SCALE_UP_BATCH=1

# Dry run: exercise the full autoscaler logic against a simulated in-memory cloud
# (no API calls, zero spend). Set to 1 to test scaling behavior safely. Default: 0.
BURST_DRY_RUN=0

# ── Free-tier on-device AI models — Optional ────────────────────────────────

# Which entries from Common/Constants/LocalLlmModelCatalogue.json this
# environment is willing to serve, comma-separated. Unset (the default) means
# every model that is actually provisioned under Dock/Assets/Models.
#
# Use it to hold a model back without deleting its files — for example to try a
# newly-added one on development while production keeps serving only the two
# it has been running. It cannot make a model available: a key listed here but
# not present on disk is simply absent from the manifest.
#
# Weights are obtained with:
#     node Common/Scripts/ProvisionLocalLlmModels.js
# See Dock/Assets/Models/README.txt.
BROWSER_LLM_ENABLED_MODELS=

# ── Misc ────────────────────────────────────────────────────────────────────

# Set to any truthy value for verbose Logger output (same as the --debug flag).
DOCK_DEBUG=
