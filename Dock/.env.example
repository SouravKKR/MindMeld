# Dock server environment configuration.
#
# Copy this file to `Dock/.env` and fill in real values. `.env` is gitignored;
# this `.env.example` is committed as documentation — keep it free of secrets.
# All values are read once at boot (dotenv) by Dock/index.js, so restart the
# server after changing anything here.

# ── Required ────────────────────────────────────────────────────────────────

# MongoDB connection string and database name.
MONGODB_URL=mongodb://127.0.0.1:27017
MONGODB_DATABASE_NAME=cogniumlearn

# Google OAuth credentials (sign-in).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Paid-deck master key — the root secret of the paid-deck encryption scheme.
# MUST be a base64-encoded 32-byte (256-bit) AES key. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Without it, KeyManagementService never becomes ready and every paid-deck
# write endpoint returns HTTP 503 KEY_MANAGEMENT_NOT_READY.
#
# WARNING: once any paid deck has been uploaded, this key MUST stay constant
# forever. It wraps every deck's content key at rest and derives all per-deck
# and per-user KEKs — losing or changing it makes all encrypted assets and
# buyer licenses permanently undecryptable. Back it up somewhere secure.
PAID_DECK_MASTER_KEY_BASE64=

# ── Access allowlist (dev/test only) ────────────────────────────────────────
# Per-environment login gate. When ENABLED, only "allowed" emails may log in
# (both Google OAuth and email-OTP paths), where allowed = the union of the
# comma-separated ACCESS_ALLOWLIST_EMAILS below, every admin email, and the
# allowedLoginEmails collection (managed in the admin panel's Access tab).
# Being on the allowlist only PERMITS login — it never grants the admin role.
#
# LEAVE ACCESS_ALLOWLIST_ENABLED BLANK IN PRODUCTION. When unset/blank the gate
# is OFF and everyone can log in exactly as normal — this is the default and the
# required production configuration. Only set it (to 1/true/yes) in a dev or
# test environment you want to lock down to a known set of testers.
ACCESS_ALLOWLIST_ENABLED=
ACCESS_ALLOWLIST_EMAILS=

# ── Recommended ─────────────────────────────────────────────────────────────

# Public origin used to build OAuth redirect URLs etc.
# Defaults to = 127.0.0.1:3000 when unset or in debug mode.
DOMAIN_NAME=

# Redis URL for the task queue and FX-rates cache.
# Defaults to redis://127.0.0.1:6379 when unset.
REDIS_URL=redis://127.0.0.1:6379

# European Central Bank daily FX reference feed (regional-price conversion).
# Defaults to the official URL below when unset.
ECB_RATES_URL=https://www.ecb.europa.eu/stats/eurofxref/eurofxref-daily.xml

# ── AI / Agent ──────────────────────────────────────────────────────────────

# Agent Vertex AI auth (GOOGLE_ENTERPRISE_AGENT_PROJECT / _CREDENTIALS_BASE64, or the slow
# _API_KEY fallback) and OPENAI_API_KEY are NOT set in this file and are NOT
# used by Dock — Dock makes no LLM calls; all AI runs in the Agent. They live
# solely in the sibling Agent env file (../Agent/.env in --debug, else
# ../Agent/.production.env) and are used only by the Agent. Dock reads that file
# ONLY to forward the keys to burst workers via cloud-init
# (BurstFleetSettings.getWorkerRuntimeEnvironment). Put the keys in the Agent env
# file, not here.

# Absolute path to the Python Agent service entry point (task processing).
AGENT_SERVICE_PATH=

# ── Payments (set the providers you use) ────────────────────────────────────

# Default provider for purchase order creation: RAZORPAY | ZOHO | STRIPE | PAYPAL.
# The frontend drives every checkout through Razorpay (window.Razorpay checkout
# widget). Zoho is retained in the backend (provider class + webhook) but no UI
# initiates it.
DEFAULT_PAYMENT_PROVIDER=RAZORPAY

# ── Zoho Payments + Zoho Invoice ────────────────────────────────────────────
# One Zoho account spans both products, so the OAuth credentials and data-center
# region below are shared. The region fixes EVERY Zoho domain this server talks
# to (accounts.zoho.* for OAuth, payments.zoho.* for sessions, www.zohoapis.*
# for invoices) and the checkout widget's `domain` value. To find yours: sign in
# at https://payments.zoho.com and read the data center from the URL you land on
# (payments.zoho.in => IN, .com => US, .eu => EU, .com.au => AU, .jp => JP,
# .ca => CA, .sa => SA). Must match the account exactly or every call 401s.
ZOHO_REGION=IN

# OAuth self-client credentials (shared by Payments + Invoice). Generate a
# refresh token whose scope covers BOTH products, e.g.:
#   ZohoPay.payments.CREATE,ZohoPay.payments.READ,ZohoPay.refunds.CREATE,
#   ZohoInvoice.invoices.CREATE,ZohoInvoice.contacts.CREATE,ZohoInvoice.contacts.READ
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=

# Zoho Payments. ACCOUNT_ID + API_KEY identify the merchant to the browser
# checkout widget (both are safe to expose client-side). SIGNING_KEY verifies the
# widget's payment response signature; WEBHOOK_SECRET verifies inbound webhooks.
# Both signing keys are generated under Zoho Payments > Settings > Developer Space.
# Without ACCOUNT_ID + OAuth creds the provider reports unconfigured and every
# Zoho checkout endpoint returns HTTP 503 PAYMENT_PROVIDER_NOT_CONFIGURED.
ZOHO_PAYMENTS_ACCOUNT_ID=
ZOHO_PAYMENTS_API_KEY=
ZOHO_PAYMENTS_SIGNING_KEY=
ZOHO_PAYMENTS_WEBHOOK_SECRET=
# Set to 1/true to route the widget through Zoho's sandbox (test mode).
ZOHO_PAYMENTS_TEST_MODE=

# Zoho Invoice. When enabled, a paid invoice is generated for each successful
# customer purchase (credits + paid decks). Invoicing is strictly best-effort —
# a failure here never blocks the credit grant or license issue. Leave
# ZOHO_INVOICE_ENABLED blank/0 to disable invoicing entirely.
ZOHO_INVOICE_ENABLED=
ZOHO_INVOICE_ORGANIZATION_ID=

# ── Razorpay (backend-retained; no frontend initiates it currently) ─────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

STRIPE_SECRET_KEY=

PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# ── Email (SMTP, optional) ──────────────────────────────────────────────────

SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_SOURCE_EMAIL=

# ── Rate limiting (optional) ────────────────────────────────────────────────
# All three are positive integers; blank/invalid values fall back to the
# defaults shown. They apply to every endpoint except static resources.

# Overall per-endpoint cap (Packetron's built-in maxRequestsPerSecond). This is
# the combined cap across all users for a single endpoint. Default: 100.
RATE_LIMIT_OVERALL_MAX_REQUESTS_PER_SECOND=100

# Per-user cap: max requests one identity (logged-in user, else client IP) may
# make within the window below before receiving 429s. Default: 300.
RATE_LIMIT_PER_USER_MAX_REQUESTS=300

# Per-user window length in seconds for the cap above. Default: 60.
RATE_LIMIT_PER_USER_WINDOW_SECONDS=60

# Dedicated tight per-IP cap for the OAuth login handshake (/Login + Callback),
# to deter login abuse. A normal sign-in is two requests. Raise for deployments
# behind a shared NAT (e.g. a school) where many users share one IP. Default: 20.
RATE_LIMIT_LOGIN_MAX_REQUESTS=20

# Window length in seconds for the login cap above. Default: 300.
RATE_LIMIT_LOGIN_WINDOW_SECONDS=300

# ── Task queue + burst fleet — Optional ─────────────────────────────────────
# Distributed task processing. When OFF (or whenever the server runs with
# --debug), Agent tasks run as local subprocesses exactly as before. When ON,
# Dock pushes tasks onto a Redis queue that long-lived worker processes drain —
# a warm baseline on this node plus optional cloud burst VMs. Everything here is
# polling-based and hard-capped, so it can never runaway-spend. Only takes effect
# in production (server started WITHOUT --debug).

# Master switch for the queue + worker pool + autoscaler. Default: off.
DOCK_USE_TASK_QUEUE=0

# How many long-lived worker processes Dock keeps running on THIS (base) node.
# These are the always-warm baseline. Default: 2.
AGENT_LOCAL_WORKER_COUNT=2

# How long Dock waits for a queued task to finish before treating it as failed.
# Kept below the 5h task TTL. Default: 10800 (3h). Poll cadence in ms below.
TASK_QUEUE_AWAIT_TIMEOUT_SECONDS=10800
TASK_QUEUE_AWAIT_POLL_MILLISECONDS=1000

# Worker liveness/claim tuning (read by Agent workers). Lease is refreshed while
# a task runs; the reaper requeues a task whose lease expired (worker crashed).
AGENT_WORKER_LEASE_SECONDS=1800
AGENT_WORKER_CLAIM_BLOCK_SECONDS=5
AGENT_WORKER_REAPER_INTERVAL_SECONDS=60
# Worker processes per burst VM (each competes on the same queue). Default: 1.
AGENT_WORKERS_PER_VM=1

# ── Cloud burst autoscaler ──────────────────────────────────────────────────
# Which cloud backend to provision burst VMs on. Swappable; LINODE is the only
# implemented provider today. Default: LINODE.
DEFAULT_CLOUD_COMPUTE_PROVIDER=LINODE

# Linode (Akamai) API personal access token with Linodes read/write scope.
LINODE_API_TOKEN=

# Region, pre-baked Image id, and instance type for BURST VMs. Burst VMs can be
# smaller/cheaper than the base node. (The base node is provisioned manually;
# BASE_INSTANCE_TYPE is documentation only and not read by the code.)
BURST_REGION=
BURST_IMAGE_ID=
BURST_INSTANCE_TYPE=
BASE_INSTANCE_TYPE=

# Linode VPC the burst VMs join so they reach Redis/Mongo over private IPs only.
BURST_VPC_ID=
BURST_SUBNET_ID=

# REQUIRED. Numeric id of the Cloud Firewall every burst VM is bound to at
# creation — use a dedicated burst firewall (inbound DROP, outbound ACCEPT). Burst
# VMs are dual-homed (public interface for egress + VPC interface for Redis/Mongo),
# so this firewall's inbound-DROP is their network protection. Fail-closed: if
# unset, the autoscaler reports unconfigured and creates NO burst VM. Find the id
# in the Linode Cloud Manager (Firewalls) or via:  GET /v4/networking/firewalls
BURST_FIREWALL_ID=

# How burst VMs reach Redis/Mongo (private VPC URLs). Fall back to the main
# REDIS_URL / MONGODB_URL if unset.
BURST_WORKER_REDIS_URL=
BURST_WORKER_MONGODB_URL=

# Identity of framework-managed instances. The autoscaler ONLY ever touches
# instances carrying this tag, and deletes ALL of them on startup so a restart
# never inherits stray burst VMs.
BURST_MANAGEMENT_TAG=cogniumlearn-burst
BURST_LABEL_PREFIX=cogniumlearn-burst-

# Warm pool floor (always-on burst VMs to hide cold-start latency) and the HARD
# cap on total burst VMs (never exceeded — the runaway-spend guard).
BURST_WARM_POOL_SIZE=2
BURST_MAX_INSTANCES=8

# Scaling shape: how many pending tasks one instance is sized to absorb, how long
# an instance must be idle before shutdown, and the reconcile poll interval.
BURST_TASKS_PER_INSTANCE=2
BURST_IDLE_TIMEOUT_SECONDS=600
BURST_RECONCILE_INTERVAL_SECONDS=30

# Cooldowns (anti-thrash) and how many VMs may be created per scale-up tick.
BURST_SCALE_UP_COOLDOWN_SECONDS=60
BURST_SCALE_DOWN_COOLDOWN_SECONDS=300
BURST_SCALE_UP_BATCH=1

# Dry run: exercise the full autoscaler logic against a simulated in-memory cloud
# (no API calls, zero spend). Set to 1 to test scaling behavior safely. Default: 0.
BURST_DRY_RUN=0

# ── Misc ────────────────────────────────────────────────────────────────────

# Set to any truthy value for verbose Logger output (same as the --debug flag).
DOCK_DEBUG=
